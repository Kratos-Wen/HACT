  },
  "matrix": {
    "seeds": [
      0
    ]
  },
  "variants": {
    "hact": {
      "transition": {
        "use_role_fusion": true,
        "use_correction_state": true,
        "correction_state_mode": "joint",
        "correction_use_error_trace": true,
        "timing_clock": "competing"
      }
