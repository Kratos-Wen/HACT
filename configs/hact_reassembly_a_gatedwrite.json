{
  "experiment_name": "hact_reassembly_a_gatedwrite",
  "output_root": "outputs/hact_reassembly_a_gatedwrite",
  "data": {
    "features_dir": "data/features/impact_videomaev2_15fps",
    "annotations_dir": "data/impact_public/reassembly_a/parsed_annotations",
    "expert_features_dir": "data/features/impact_videomaev2_15fps",
    "expert_annotations_dir": "data/impact_public/reassembly_a/parsed_annotations_expert",
    "expert_annotation_mode": "decoded_only",
    "expert_ids": [
      "ER07AD15_Reassembly_A_002_ego",
      "ER07AD15_Reassembly_A_003_ego"
    ],
    "auto_discover_experts": false,
    "expert_fps": 15.0,
    "sop_path": "configs/public_impact/sop_reassembly_a.json",
